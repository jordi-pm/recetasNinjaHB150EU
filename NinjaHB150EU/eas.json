{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "ios": {
        "resourceClass": "m-medium"
      },
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "TU_APPLE_ID@ejemplo.com",
        "ascAppId": "RELLENAR_DESPUES_DE_CREAR_LA_APP",
        "appleTeamId": "RELLENAR_CON_TU_TEAM_ID"
      }
    }
  }
}